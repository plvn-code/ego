# Copy to .env.local (never commit real values). On Vercel: Settings → Environment Variables.

# Orders → manager's Telegram. Without these, production checkout refuses orders
# (so nobody gets "thank you" for an order that reaches no one); local dev logs them to the terminal.
TELEGRAM_BOT_TOKEN=
# One or more chat ids (comma-separated): a manager's private chat or a group with the bot
TELEGRAM_CHAT_ID=

# At launch
NEXT_PUBLIC_ALLOW_INDEXING=
NEXT_PUBLIC_SITE_URL=
